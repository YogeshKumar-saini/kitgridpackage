{
  "name": "@yogeshsaini/kitgrid",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Accessible React components with premium motion and a full commerce kit. Zero runtime dependencies, works with or without Tailwind.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./theme.css": "./dist/theme.css",
    "./utilities.css": "./dist/utilities.css",
    "./package.json": "./package.json",
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./charts/styles.css": "./dist/charts/styles.css",
    "./*/styles.css": "./dist/components/*/styles.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/check-classes.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "echarts": "^6.1.0",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "animation",
    "motion",
    "ecommerce",
    "accessible",
    "tailwind",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
